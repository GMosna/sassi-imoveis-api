# Preencher com as credenciais que o Reginaldo liberou
# Renomear este arquivo para ".env" e nunca commitar o .env real no git

# Enquanto não validar tudo, deixe USE_MOCK_DATA=true
# O serviço responde com 3 imóveis fictícios, pra testar a conexão com o RD
# Quando for testar contra o banco real, troque para "false"
USE_MOCK_DATA=true

DB_HOST=seu_host_aqui
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Token que o RD Station vai enviar no header Authorization
# Gere uma string aleatória longa, ex: openssl rand -hex 32
API_TOKEN=

PORT=3000

# --- Marcação de leads de retorno no RD CRM (src/marcacao) ---
# desligado (padrão), simulacao (só lê e registra), teste (só grava no Funil
# de Testes, em contatos de EMAILS_TESTE) ou ativo
MARCACAO_MODO=desligado
# Token do usuário do CRM (Configurações > Meu perfil). Só no Railway, nunca no git.
# A marcação usa só esta variável: ligar a marcação não reativa o
# /registrar-lead, que usa RDCRM_TOKEN.
MARCACAO_RDCRM_TOKEN=
INTERVALO_MINUTOS=5
ESPERA_TAREFA_MINUTOS=10
# Opcionais: os padrões já são os da Sassi
# FUNIS_PERMITIDOS=66eaadbee736e20026d75b62,65024237f7a7d8000d3065ad,66670e271d7b460012926d40,651eecde2b5b67000d833026
# FUNIL_TESTES_ID=6a723eee480c33002099c27d
# CAMPO_TIPO_ENTRADA_ID=6ad21923aa78e90029fa490b
# CONTATOS_INTERNOS=(19) 99368-1809,(19) 99368-1824,(19) 3404-4499,@sassiimoveis.com.br
# EMAILS_TESTE=
# MARCACAO_REENVIAR_CAMPOS=nao
